diff --git a/tests/codexCustomization.test.ts b/tests/codexCustomization.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..3a7672f86dfa573de864c88b6aa87e1850e1189d
--- /dev/null
+++ b/tests/codexCustomization.test.ts
@@ -0,0 +1,138 @@
+import { describe, expect, test } from 'bun:test';
+import { createInstance } from 'i18next';
+import { createElement, type ReactElement } from 'react';
+import { renderToStaticMarkup } from 'react-dom/server';
+import { I18nextProvider } from 'react-i18next';
+import en from '@/i18n/locales/en.json';
+import type { AuthFileItem, CodexQuotaState } from '@/types';
+import { getQuotaCacheKey } from '@/utils/quota/identity';
+import { getQuotaDisplayName } from '@/features/quota/customization/displayName';
+import {
+  buildQuotaLaneLabels,
+  QuotaFileContext,
+  QuotaLaneLabelsContext,
+} from '@/features/quota/customization/state';
+import { QuotaTimeline } from '@/features/quota/components/QuotaTimeline';
+import { CodexQuotaBody } from '@/features/quota/providers/codex/CodexQuotaBody';
+import { classifyQuotaFiles, sortQuotaEntries } from '@/features/quota/logic';
+import { bindQuotaClasses, QUOTA_CLASS_KEYS } from '@/features/quota/types';
+
+const file: AuthFileItem = {
+  name: 'codex-primary.json',
+  provider: 'codex',
+  email: 'demo@example.test',
+  priority: 3,
+};
+const now = new Date(2026, 6, 29, 12).getTime();
+const quota: CodexQuotaState = {
+  status: 'success',
+  planType: 'plus',
+  rateLimitResetCreditsAvailableCount: 2,
+  windows: [
+    {
+      id: 'weekly',
+      label: '7-day',
+      usedPercent: 25,
+      resetAtMs: now + 86400000,
+      periodHours: 168,
+      resetLabel: null,
+    },
+  ],
+};
+const classes = bindQuotaClasses(
+  Object.fromEntries(QUOTA_CLASS_KEYS.map((key) => [key, key])),
+  'customization-test'
+);
+
+const translations = createInstance();
+await translations.init({
+  lng: 'en',
+  resources: { en: { translation: en } },
+  react: { useSuspense: false },
+});
+const render = (element: ReactElement) =>
+  renderToStaticMarkup(createElement(I18nextProvider, { i18n: translations }, element));
+
+describe('Codex customization boundaries', () => {
+  test('uses one email label for Codex cards and lanes while retaining file identity', () => {
+    expect(getQuotaDisplayName(file)).toBe(file.email!);
+    expect(getQuotaCacheKey(file)).toBe(file.name);
+    const entries = [{ file, type: 'codex' as const }];
+    const markup = render(
+      createElement(
+        QuotaLaneLabelsContext.Provider,
+        { value: buildQuotaLaneLabels(entries) },
+        createElement(QuotaTimeline, {
+          entries,
+          quotaFor: () => quota,
+          displayNameFor: (name) => name,
+          resolvedTheme: 'light',
+          now,
+        })
+      )
+    );
+    expect(markup).toContain(`title="${file.name}">${file.email}</span>`);
+    expect(markup).toContain(`title="${file.name}\n`);
+    expect(getQuotaDisplayName({ ...file, provider: 'claude' })).toBe(file.name);
+  });
+
+  test('preserves upstream identity labels for Devin and plugin quota providers', () => {
+    const plugin: AuthFileItem = {
+      name: 'shared.json',
+      provider: 'example-plugin',
+      supportsQuota: true,
+      authIndex: '42',
+      account: 'secret',
+    };
+    for (const credential of [plugin, { ...plugin, provider: 'devin', supportsQuota: false }]) {
+      expect(getQuotaDisplayName(credential)).toBe('shared.json · 42');
+      expect(getQuotaDisplayName({ ...credential, email: 'demo@example.test' })).toBe(
+        'shared.json · demo@example.test'
+      );
+      expect(getQuotaDisplayName({ ...credential, authIndex: undefined })).toBe('shared.json');
+      expect(getQuotaCacheKey(credential)).toBe('shared.json\0' + '42');
+    }
+  });
+
+  test('places priority after reset credits only when the quota host supplies file metadata', () => {
+    const card = render(
+      createElement(
+        QuotaFileContext.Provider,
+        { value: file },
+        createElement(CodexQuotaBody, { quota, classes })
+      )
+    );
+    expect(
+      render(
+        createElement(
+          QuotaFileContext.Provider,
+          { value: { ...file, priority: 1.5 } },
+          createElement(CodexQuotaBody, { quota, classes })
+        )
+      )
+    ).not.toContain('>Priority</span>');
+    expect(card).toMatch(/>2<\/span>[\s\S]*>Priority<\/span><span>3<\/span>/);
+    const withoutFile = render(createElement(CodexQuotaBody, { quota, classes }));
+    expect(withoutFile).not.toContain('>Priority</span>');
+  });
+
+  test('sorts Codex priorities stably without reordering other provider groups', () => {
+    const entries = classifyQuotaFiles([
+      { name: 'claude-first', provider: 'claude', priority: 9 },
+      { name: 'claude-second', provider: 'claude', priority: -9 },
+      { ...file, name: 'codex-high', priority: 5 },
+      { ...file, name: 'codex-low-first', priority: -1 },
+      { ...file, name: 'codex-low-second', priority: -1 },
+    ]);
+    const original = entries.map((entry) => entry.file.name);
+    const result = sortQuotaEntries(entries, 'default', () => null);
+    expect(result.map((entry) => entry.file.name)).toEqual([
+      'claude-first',
+      'claude-second',
+      'codex-low-first',
+      'codex-low-second',
+      'codex-high',
+    ]);
+    expect(entries.map((entry) => entry.file.name)).toEqual(original);
+  });
+});
