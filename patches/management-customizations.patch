+/**
+ * Customization data supplied by the quota-page hosts through context, so
+ * upstream render paths and component props stay unchanged.
+ */
+
+import { createContext, useContext } from 'react';
+import type { AuthFileItem } from '@/types';
+import { getQuotaCacheKey } from '@/utils/quota/identity';
+import type { QuotaFileEntry } from '../logic';
+import { getQuotaDisplayName } from './displayName';
+
+export const QuotaFileContext = createContext<AuthFileItem | undefined>(undefined);
+export const QuotaLaneLabelsContext = createContext<ReadonlyMap<string, string>>(new Map());
+
+/** Codex lane labels keyed by the upstream lane identity. */
+export const buildQuotaLaneLabels = (
+  entries: readonly QuotaFileEntry[]
+): ReadonlyMap<string, string> =>
+  new Map(
+    entries
+      .filter((entry) => entry.type === 'codex')
+      .map((entry) => [getQuotaCacheKey(entry.file), getQuotaDisplayName(entry.file)])
+  );
+
+/** Priority of the quota-page card's file; undefined elsewhere or when invalid. */
+export function useQuotaFilePriority(): number | undefined {
+  const priority = useContext(QuotaFileContext)?.priority;
+  return Number.isSafeInteger(priority) ? priority : undefined;
+}
