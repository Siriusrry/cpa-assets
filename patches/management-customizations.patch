+/**
+ * Quota-page hosts: wrap upstream components and supply customization data.
+ */
+
+import { useMemo, type ComponentProps } from 'react';
+import { QuotaCard as UpstreamQuotaCard, type QuotaCardProps } from '../components/QuotaCard';
+import { QuotaTimeline as UpstreamQuotaTimeline } from '../components/QuotaTimeline';
+import { buildQuotaLaneLabels, QuotaFileContext, QuotaLaneLabelsContext } from './state';
+
+export function QuotaCard(props: QuotaCardProps) {
+  return (
+    <QuotaFileContext.Provider value={props.entry.file}>
+      <UpstreamQuotaCard {...props} />
+    </QuotaFileContext.Provider>
+  );
+}
+
+export function QuotaTimeline(props: ComponentProps<typeof UpstreamQuotaTimeline>) {
+  const { entries } = props;
+  const labels = useMemo(() => buildQuotaLaneLabels(entries), [entries]);
+  return (
+    <QuotaLaneLabelsContext.Provider value={labels}>
+      <UpstreamQuotaTimeline {...props} />
+    </QuotaLaneLabelsContext.Provider>
+  );
+}
