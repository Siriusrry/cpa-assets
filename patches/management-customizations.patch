+import { getQuotaDisplayName as getUpstreamQuotaDisplayName } from '@/utils/quota/identity';
+import { isCodexFile } from '@/utils/quota/validators';
+
+export function getQuotaDisplayName(file: AuthFileItem): string {
+  return isCodexFile(file) ? file.email! : getUpstreamQuotaDisplayName(file);
+}
