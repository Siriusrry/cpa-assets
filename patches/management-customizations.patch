+import { useContext } from 'react';
+import { useTranslation } from 'react-i18next';
+import type { TimelineLane } from '../quotaTimelineModel';
+import { QuotaLaneLabelsContext } from './state';
+import styles from './CodexPriority.module.scss';
+
+export function CodexPriorityBadge({ priority }: { priority: number | undefined }) {
+  const { t } = useTranslation();
+  if (priority === undefined) return null;
+  return (
+    <span className={styles.priority} title={t('auth_files.priority_hint')}>
+      <span className={styles.priorityLabel}>{t('auth_files.priority_display')}</span>
+      <span>{priority}</span>
+    </span>
+  );
+}
+
+export function QuotaLaneLabel({ lane }: { lane: Pick<TimelineLane, 'name' | 'displayName'> }) {
+  return <>{useContext(QuotaLaneLabelsContext).get(lane.name) ?? lane.displayName}</>;
+}
